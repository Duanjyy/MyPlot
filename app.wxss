/* ============ iTwitter 全局样式（X/Twitter 默认浅色主题 1:1 复刻） ============ */
page {
  /* X 官方设计令牌（浅色） */
  --bg: #ffffff;
  --hover: #f7f9f9;
  --border: #eff3f4;
  --secondary: #536471;
  --text: #0f1419;
  --accent: #1d9bf0;
  --accent-hover: #1a8cd8;
  --like: #f91880;
  --rt: #00ba7c;
  --danger: #f4212e;
  --dim: rgba(91, 112, 131, 0.4);

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.4;
  -webkit-font-smoothing: antialiased;
}

view, text, image, button, input, textarea {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: none;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
  border-radius: 0;
}
button::after {
  border: none;
}

/* 通用工具类 */
.flex { display: flex; align-items: center; }
.flex-1 { flex: 1; min-width: 0; }
.spacer { flex: 1; }
.secondary { color: var(--secondary); }
.accent { color: var(--accent); }

/* 圆角胶囊按钮（X 关注/发帖按钮样式） */
.pill-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 9999rpx;
  font-weight: 600;
  transition: opacity 0.15s ease, background-color 0.15s ease;
}
.pill-btn:active { opacity: 0.85; }

/* 点击反馈：移动端轻微透明反馈 */
.press { transition: opacity 0.12s ease; }
.press:active { opacity: 0.7; }

/* 分割线 */
.divider { height: 1px; background: var(--border); transform: scaleY(0.5); }

/* 底部安全区 */
.safe-bottom { padding-bottom: constant(safe-area-inset-bottom); padding-bottom: env(safe-area-inset-bottom); }

/* 骨架屏 */
.skeleton {
  background: linear-gradient(90deg, #f0f3f4 25%, #e1e8ed 37%, #f0f3f4 63%);
  background-size: 400% 100%;
  animation: skeleton-sweep 1.4s ease infinite;
  border-radius: 8rpx;
}
@keyframes skeleton-sweep {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* 底部加载 spinner（X 的蓝色圆环） */
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(29, 155, 240, 0.25);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 吸顶毛玻璃背景 */
.blur-top {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}
