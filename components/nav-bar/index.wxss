.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}
.nav-body {
  display: flex;
  align-items: center;
  padding: 0 12rpx;
}
.left {
  display: flex;
  align-items: center;
  min-width: 0;
}
.title {
  font-size: 34rpx;
  font-weight: 600;
  margin-left: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.spacer { flex: 1; }
.icon-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.icon-btn:active { opacity: 0.6; }
.icon {
  width: 44rpx;
  height: 44rpx;
}
