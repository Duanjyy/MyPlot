.tweet {
  padding: 24rpx 32rpx 12rpx;
  border-bottom: 1rpx solid var(--border);
  transition: background-color 0.15s ease;
}
.tweet:active { background: var(--hover); }
.row { display: flex; }

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 20rpx;
  background: var(--border);
}

.main { flex: 1; min-width: 0; }

/* 头部 */
.head { display: flex; align-items: center; min-width: 0; }
.name {
  font-weight: 600;
  font-size: 30rpx;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 320rpx;
}
.vbadge { width: 32rpx; height: 32rpx; margin: 0 6rpx; flex-shrink: 0; }
.meta {
  color: var(--secondary);
  font-size: 30rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-shrink: 1;
}
.spacer { flex: 1; }
.mini-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  flex-shrink: 0;
}
.mini-btn:active { opacity: 0.6; }

/* 正文 */
.body { margin-top: 2rpx; }
.txt {
  font-size: 30rpx;
  line-height: 1.45;
  color: var(--text);
  white-space: pre-line;
  word-break: break-word;
}
.tag {
  display: block;
  color: var(--accent);
  font-size: 30rpx;
  margin-top: 4rpx;
}

/* 媒体：多图横向连续滑动条（图片相连、跟手滚动） */
.media {
  margin-top: 24rpx;
  border-radius: 32rpx;
  overflow: hidden;
  border: 1rpx solid var(--border);
  position: relative;
}
.media-scroll { width: 100%; height: 400rpx; }
.media-strip { display: flex; height: 400rpx; }
.media-img {
  width: 586rpx;
  height: 400rpx;
  flex-shrink: 0;
  background: var(--border);
}

/* 引用 */
.quoted {
  margin-top: 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 32rpx;
  padding: 24rpx;
  overflow: hidden;
}
.q-head { display: flex; align-items: center; }
.q-avatar { width: 40rpx; height: 40rpx; border-radius: 50%; margin-right: 12rpx; }
.q-name { font-weight: 600; font-size: 28rpx; }
.q-badge { width: 28rpx; height: 28rpx; margin: 0 4rpx; }
.q-handle { color: var(--secondary); font-size: 28rpx; }
.q-text {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.4;
  white-space: pre-line;
}
.q-media {
  margin-top: 16rpx;
  width: 100%;
  height: 240rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--border);
}

/* 互动栏 */
.actions {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  max-width: 640rpx;
}
.act-group {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-right: 16rpx;
}
.act {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
  margin-left: -8rpx;
}
.act:active { opacity: 0.6; }
.act-right { display: flex; align-items: center; gap: 8rpx; }
.action-icon { width: 34rpx; height: 34rpx; }
.act-num {
  margin-left: 10rpx;
  color: var(--secondary);
  font-size: 26rpx;
  min-width: 40rpx;
}
.pink { color: var(--like); }
.green { color: var(--rt); }

/* 点赞心跳 */
.beat { animation: beat 0.35s ease; }
@keyframes beat {
  0% { transform: scale(0.6); }
  55% { transform: scale(1.25); }
  100% { transform: scale(1); }
}
.rted { transition: transform 0.2s ease; }
