/* 搜索条：X 发现页通栏样式（宽度/高度由 JS 按原生胶囊计算，与胶囊等高对齐） */
.search-pill {
  background: var(--border);
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.search-pill:active { background: #e1e8ed; }
.sp-icon { width: 36rpx; height: 36rpx; margin-right: 16rpx; }
.sp-text { color: var(--secondary); font-size: 30rpx; }

/* 底部避让自定义 TabBar */
.bottom-pad {
  height: 160rpx; /* 静态兜底 */
  height: calc(160rpx + constant(safe-area-inset-bottom));
  height: calc(160rpx + env(safe-area-inset-bottom));
}

/* tabs */
.tabs {
  position: sticky;
  z-index: 90;
  display: flex;
  border-bottom: 1rpx solid var(--border);
}
.tab-item { flex: 1; height: 88rpx; display: flex; align-items: center; justify-content: center; position: relative; }
.tab-item text { font-size: 32rpx; font-weight: 500; color: var(--secondary); }
.tab-item.active text { color: var(--text); font-weight: 600; }
.underline { position: absolute; bottom: 0; width: 0; height: 6rpx; border-radius: 6rpx; background: var(--accent); transition: width 0.25s ease; }
.tab-item.active .underline { width: 50%; }

.section-title { display: block; padding: 28rpx 32rpx 12rpx; font-size: 34rpx; font-weight: 700; }
.divider.thick { height: 16rpx; background: var(--border); transform: none; }

/* 趋势行 */
.trend {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
}
.trend:active { background: var(--hover); }
.trend-left { flex: 1; min-width: 0; }
.trend-head { display: flex; align-items: center; }
.trend-cat { color: var(--secondary); font-size: 26rpx; }
.badge {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.badge.hot { color: #ff3b30; background: rgba(244, 33, 46, 0.15); }
.badge.fresh { color: #00ba7c; background: rgba(0, 186, 124, 0.15); }
.trend-topic { display: block; font-size: 32rpx; font-weight: 600; margin-top: 6rpx; }
.trend-posts { display: block; color: var(--secondary); font-size: 26rpx; margin-top: 4rpx; }
.trend-up { width: 32rpx; height: 32rpx; }

/* 热门榜 */
.hot-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--border);
}
.hot-row:active { background: var(--hover); }
.hot-rank { width: 64rpx; color: var(--secondary); font-size: 36rpx; font-weight: 600; font-style: italic; }
.hot-main { flex: 1; min-width: 0; }
.hot-topic { display: block; font-size: 32rpx; font-weight: 600; }
.hot-cat { display: block; color: var(--secondary); font-size: 26rpx; margin-top: 6rpx; }

/* 推荐账号 */
.user-row { display: flex; align-items: flex-start; padding: 24rpx 32rpx; }
.user-row:active { background: var(--hover); }
.ur-avatar { width: 88rpx; height: 88rpx; border-radius: 50%; margin-right: 20rpx; flex-shrink: 0; }
.ur-main { flex: 1; min-width: 0; margin-right: 16rpx; }
.ur-line { display: flex; align-items: center; }
.ur-name { font-weight: 600; font-size: 30rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ur-badge { width: 30rpx; height: 30rpx; margin-left: 8rpx; flex-shrink: 0; }
.ur-handle { display: block; color: var(--secondary); font-size: 28rpx; margin-top: 2rpx; }
.ur-bio {
  display: block;
  color: var(--text);
  font-size: 28rpx;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.follow {
  background: #fff;
  color: #0f1419;
  border: 1rpx solid #cfd9de;
  font-size: 28rpx;
  padding: 12rpx 36rpx;
  flex-shrink: 0;
}
.follow.ing { background: transparent; color: var(--text); border: 1rpx solid #536471; }
