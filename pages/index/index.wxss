/* 顶部：头像与标题在同一 flex 行内强制上下居中 */
.nav-left {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}
.nav-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--border);
  display: block;
  flex-shrink: 0;
}
.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-left: 24rpx;
  color: var(--text);
  line-height: 1;
}

/* 底部避让自定义 TabBar（图标区 100rpx + 安全区） */
.bottom-pad {
  height: 160rpx; /* 静态兜底 */
  height: calc(160rpx + constant(safe-area-inset-bottom));
  height: calc(160rpx + env(safe-area-inset-bottom));
}

/* tabs */
.tabs {
  position: sticky;
  z-index: 90;
  display: flex;
  border-bottom: 1rpx solid var(--border);
}
.tab-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: color 0.15s ease;
}
.tab-item text { font-size: 32rpx; font-weight: 500; color: var(--secondary); }
.tab-item.active text { color: var(--text); font-weight: 600; }
.underline {
  position: absolute;
  bottom: 0;
  width: 0;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--accent);
  transition: width 0.25s ease;
}
.tab-item.active .underline { width: 50%; }

/* 空态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 80rpx 0;
}
.empty-title { font-size: 40rpx; font-weight: 700; margin-top: 48rpx; }
.empty-sub { font-size: 30rpx; color: var(--secondary); margin-top: 20rpx; text-align: center; line-height: 1.5; }
.empty-btn { margin-top: 56rpx; background: var(--accent); color: #fff; font-size: 30rpx; padding: 20rpx 56rpx; }

/* 底部加载 */
.foot { display: flex; justify-content: center; padding: 40rpx 0; }
.foot-text { color: var(--secondary); font-size: 28rpx; }

/* 浮动发布按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx; /* 静态兜底：env() 失效时仍保持与 TabBar 的安全间距 */
  /* TabBar 内容区 100rpx + 安全区，再留 60rpx 呼吸间距，任何机型都不贴合 */
  bottom: calc(150rpx + constant(safe-area-inset-bottom));
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 95;
  box-shadow: 0 8rpx 24rpx rgba(29, 155, 240, 0.35);
}
.fab:active { transform: scale(0.94); }
/* 图标保持正方形比例，禁止拉伸变形 */
.fab-icon {
  width: 44rpx;
  height: 44rpx;
  max-width: 44rpx;
}

/* ---------- 全屏发布器 ---------- */
.compose {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: var(--bg);
  display: flex;
  flex-direction: column;
}
.compose.in { animation: slide-up 0.22s ease; }
.compose.out { animation: slide-down 0.22s ease forwards; }
@keyframes slide-up { from { transform: translateY(10%); opacity: 0.4; } to { transform: translateY(0); opacity: 1; } }
@keyframes slide-down { from { transform: translateY(0); opacity: 1; } to { transform: translateY(10%); opacity: 0; } }

.compose-nav-body {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.icon-btn { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; }
.icon-btn:active { opacity: 0.6; }
.c-icon { width: 44rpx; height: 44rpx; }
.audience {
  background: rgba(29, 155, 240, 0.15);
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 600;
  padding: 10rpx 28rpx;
  margin-left: 12rpx;
}
.send {
  background: rgba(29, 155, 240, 0.5);
  color: #fff;
  font-size: 30rpx;
  padding: 14rpx 40rpx;
  margin-left: 16rpx;
}
.send.on { background: var(--accent); color: #fff; }

.compose-body {
  flex: 1;
  padding: 24rpx 32rpx;
  display: flex;
}
.c-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; margin-right: 20rpx; flex-shrink: 0; }
.c-input {
  flex: 1;
  font-size: 40rpx;
  line-height: 1.4;
  min-height: 300rpx;
  color: var(--text);
}
.c-ph { color: var(--secondary); font-size: 40rpx; }

.compose-foot {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--border);
}
.tool { width: 44rpx; height: 44rpx; margin-right: 44rpx; }
.count { color: var(--secondary); font-size: 26rpx; }
.count.warn { color: #cf7d00; }
