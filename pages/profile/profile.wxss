/* 封面 */
.banner-wrap { height: 320rpx; background: var(--border); }
.banner { width: 100%; height: 100%; }

/* 头像 + 操作 */
.profile-top {
  display: flex;
  align-items: flex-start;
  padding: 0 32rpx;
  margin-top: -120rpx;
  position: relative;
}
.avatar-wrap { padding: 8rpx; background: var(--bg); border-radius: 50%; }
.avatar { width: 200rpx; height: 200rpx; border-radius: 50%; background: var(--border); border: 8rpx solid var(--bg); }
.actions-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 40rpx;
}
.icon-action {
  width: 88rpx;
  height: 72rpx;
  border: 1rpx solid #cfd9de;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-action:active { opacity: 0.6; }
.icon-action-icon { width: 36rpx; height: 36rpx; }
.action {
  border: 1rpx solid #cfd9de;
  color: var(--text);
  font-size: 30rpx;
  padding: 14rpx 44rpx;
}
.action.ing { background: transparent; }
.action.ing { color: var(--text); }

/* 身份信息 */
.identity { padding: 20rpx 32rpx 0; }
.name-row { display: flex; align-items: center; }
.name { font-size: 44rpx; font-weight: 700; }
.vbadge { width: 40rpx; height: 40rpx; margin-left: 12rpx; }
.handle { display: block; color: var(--secondary); font-size: 32rpx; margin-top: 4rpx; }
.bio { display: block; font-size: 32rpx; line-height: 1.45; margin-top: 20rpx; white-space: pre-line; }
.meta-row { display: flex; flex-wrap: wrap; gap: 24rpx; margin-top: 20rpx; }
.meta { display: flex; align-items: center; color: var(--secondary); font-size: 28rpx; }
.meta-icon { width: 30rpx; height: 30rpx; margin-right: 8rpx; }
.stats-row { display: flex; margin-top: 24rpx; gap: 40rpx; }
.stat { color: var(--secondary); font-size: 30rpx; }
.stat-n { color: var(--text); font-weight: 600; }

/* 空态 */
.list-gap { height: 24rpx; }
.p-empty { padding: 120rpx 80rpx; display: flex; flex-direction: column; align-items: center; }
.p-empty-t { font-size: 36rpx; font-weight: 700; }
.p-empty-s { margin-top: 16rpx; color: var(--secondary); font-size: 30rpx; text-align: center; }

/* 底部避让自定义 TabBar */
.bottom-pad {
  height: 160rpx; /* 静态兜底 */
  height: calc(160rpx + constant(safe-area-inset-bottom));
  height: calc(160rpx + env(safe-area-inset-bottom));
}

/* 编辑资料弹层 */
.mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: var(--dim);
  opacity: 0;
  transition: opacity 0.22s ease;
}
.mask.mask-in, .mask.out { opacity: 1; }
.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg);
  border-radius: 32rpx 32rpx 0 0;
  padding: 0 32rpx calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
}
.sheet.in { animation: sheet-up 0.24s ease forwards; }
.sheet.out { transform: translateY(0); opacity: 0; transition: all 0.22s ease; }
@keyframes sheet-up { to { transform: translateY(0); } }
.sheet-nav { display: flex; align-items: center; justify-content: space-between; padding: 32rpx 0 24rpx; }
.sheet-close { color: var(--text); font-size: 30rpx; }
.sheet-title { font-size: 32rpx; font-weight: 700; }
.sheet-save {
  background: rgba(29, 155, 240, 0.5);
  color: #fff;
  font-size: 28rpx;
  padding: 12rpx 36rpx;
}
.sheet-save.on { background: var(--accent); color: #fff; }

/* 字段 */
.field { border: 1rpx solid var(--border); border-radius: 12rpx; padding: 16rpx 24rpx; margin-top: 24rpx; }
.f-label { color: var(--secondary); font-size: 24rpx; }
.f-input { margin-top: 8rpx; font-size: 30rpx; color: var(--text); height: 56rpx; }
.f-ph { color: var(--secondary); font-size: 30rpx; }
